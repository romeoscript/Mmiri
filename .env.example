# Mmiri — copy to .env and fill in. .env is gitignored and must never be committed.
#
# Nothing in this file is needed to run the tests or the simulation. Those are
# fully offline. These values are only for the live testnet demo.

# ---- NEAR testnet ----
# Parent account you created by hand. All other accounts are sub-accounts of it.
MMIRI_PARENT=
# Derived, no need to edit unless you renamed things.
MMIRI_MARKET=market.${MMIRI_PARENT}
MMIRI_USDC=usdc.${MMIRI_PARENT}
MMIRI_KEEPER=keeper.${MMIRI_PARENT}

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# ---- Underwriter agents ----
# Function-call-only private keys, scoped to the market contract and the bid
# methods. Generated by scripts/setup-agents. NEVER a full-access key: an agent
# holding one of these cannot transfer NEAR, add keys, or call any other contract.
UW_1_KEY=
UW_2_KEY=
UW_3_KEY=
UW_4_KEY=
UW_5_KEY=

# Keeper's function-call key, scoped to submit_observation only.
# Used only when the oracle runs in keeper mode (see README, oracle trust model).
KEEPER_KEY=

# ---- OutLayer (oracle mode only) ----
OUTLAYER_CONTRACT=outlayer.testnet
# Published oracle WASM and its sha256. The contract pins the hash, so a worker
# cannot substitute different code.
ORACLE_WASM_URL=
ORACLE_WASM_SHA256=

# ---- NEAR Intents / 1Click ----
# Base URL. No API key is required for dry quotes; one raises the fee tier.
# Register at https://partners.near-intents.org if you want a JWT.
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
# Live mode sends real mainnet value. Leave false. Flipping this needs a
# deliberate decision, not a default.
ONECLICK_LIVE=false
